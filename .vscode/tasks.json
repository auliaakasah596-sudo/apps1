{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: install",
      "type": "shell",
      "command": "npm install",
      "group": "build",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "npm: lint",
      "type": "shell",
      "command": "npm run lint",
      "group": "test",
      "presentation": { "reveal": "silent" }
    },
    {
      "label": "Run checks (install + lint)",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File ./.vscode/run_checks.ps1",
      "presentation": { "reveal": "always" }
    }
  ]
}
